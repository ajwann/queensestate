# Settings for scripts/deploy-gcp.sh. Copy to .env and fill in, or export them.
# The script prompts for anything unset; pass the SAME settings on every run,
# because it keeps no state of its own besides the client secret.
#
#   cp .env.example .env && set -a && . ./.env && set +a && scripts/deploy-gcp.sh

# Deploy into an existing project rather than a new queensestate-xxxxxx.
QUEENSESTATE_GCP_PROJECT=adam-wanningers-mcp-servers

# Serve at this domain instead of the run.app URL. It must be verified in Google
# Search Console, and its DNS record must be DNS-only (not proxied) on Cloudflare.
QUEENSESTATE_DOMAIN=queensestate.adamwanninger.com

# Who may sign in. At least one of these three is required, or the server
# refuses to start rather than admitting every Google account on the internet.
QUEENSESTATE_ALLOW_ANY_GOOGLE_ACCOUNT=true
# QUEENSESTATE_ALLOWED_EMAILS=you@gmail.com,someone@else.com
# QUEENSESTATE_ALLOWED_DOMAINS=example.com

# The budget and kill switch are shared with every other server in this project,
# and owned by ../mcp-servers-shared-cap. This tells the deploy to create
# neither, so the two servers are not measuring the same money twice.
QUEENSESTATE_SHARED_BUDGET=true

# Only if this server should own a budget of its own instead (leave SHARED_BUDGET
# unset then). A cap unlinks billing for the WHOLE project either way.
# QUEENSESTATE_SPEND_CAP=true
# QUEENSESTATE_BUDGET_USD=5
# QUEENSESTATE_SPEND_CAP_AT=1.0

# From the Google OAuth Web client. The secret is stored in Secret Manager and
# only has to be supplied once; later runs reuse it unless --reset-secret.
# QUEENSESTATE_GOOGLE_CLIENT_ID=
# QUEENSESTATE_GOOGLE_CLIENT_SECRET=
